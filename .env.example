# Copy to .env.local and fill in. Never commit real values.
# Every service runs in a free or sandbox tier; no real money moves.

# PayPal sandbox (developer.paypal.com → Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Amazon Nova on Bedrock: an IAM user that may only invoke eu.amazon.nova-* inference profiles.
# Not AWS_* names, because Vercel reserves those.
BEDROCK_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# Groq (Whisper large-v3 translations: Swahili voice notes → English text)
GROQ_API_KEY=

# Twilio Sandbox for WhatsApp (console.twilio.com → Account Dashboard; use the Live credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Real test phones mapped onto the seeded contacts. Never commit real numbers.
# Example: +254700000000=c-peter,+254700000001=c-grace
WHATSAPP_TEST_PHONES=
# Optional: the webhook URL as set in Twilio. Defaults to the Vercel production URL.
TWILIO_WEBHOOK_URL=

# Neon Postgres and Vercel Blob are connected to the Vercel project, which sets these.
# Locally: vercel env pull .env.development.local --environment=development --yes
# (re-run it when Blob calls fail: VERCEL_OIDC_TOKEN is short-lived).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
