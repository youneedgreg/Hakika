# Copy to .env.local and fill in. Never commit real values.
# Every service runs in a free or sandbox tier; no real money moves.

# PayPal sandbox (developer.paypal.com → Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Amazon Nova on Bedrock: an IAM user that may only invoke eu.amazon.nova-* inference profiles.
# Not AWS_* names, because Vercel reserves those.
BEDROCK_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# Groq (Whisper large-v3 translations: Swahili voice notes → English text)
GROQ_API_KEY=
